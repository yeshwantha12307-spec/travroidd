# TRAVROIDD ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure the variables for production

PORT=5001
NODE_ENV=development
JWT_SECRET=travroidd_super_secure_jwt_secret_change_in_production_2026

# Admin Credentials Setup
ADMIN_EMAIL=admin@travroidd.com
ADMIN_INITIAL_PASSWORD=admin@travels

# Supabase Authentication & Database
# Public client configuration (Safe for browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side ONLY (CRITICAL: NEVER prefix with VITE_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (configured in Supabase Dashboard > Authentication > Providers > Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
