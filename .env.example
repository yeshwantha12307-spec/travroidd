# TRAVROIDD ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure the variables for production

# Server Port (default: 5001)
PORT=5001

# Node Environment ('development' | 'production')
NODE_ENV=development

# JWT Secret Key for Session Signing (Minimum 32 characters in production)
JWT_SECRET=travroidd_super_secure_jwt_secret_change_in_production_2026

# Admin Credentials Setup
# On initial startup or seed, the admin account is provisioned with this password.
# Passwords are never stored in plaintext; they are hashed with bcrypt (12 rounds).
# On first login, the admin is mandated to change this password.
ADMIN_EMAIL=admin@travroidd.com
ADMIN_INITIAL_PASSWORD=admin@travels

# Google OAuth 2.0 Credentials (Google Cloud Console)
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials
# 3. Create an OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized JavaScript origins:
#    - http://localhost:5173
#    - https://your-production-domain.com
# 5. Add Authorized redirect URIs if using redirect flow
# 6. Paste your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
